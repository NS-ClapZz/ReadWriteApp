<Window x:Class="ReadWriteApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши — Каталог" 
        Height="620" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#ECF0F1">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📚 Читай, Пиши и не спиши" 
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="UserInfoText" Text="" 
                               FontSize="12" Foreground="#BDC3C7"
                               VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ProfileButton" Content="👤 Профиль"
                            FontSize="12" Padding="10,5"
                            Background="#3498DB" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="ProfileButton_Click"
                            Visibility="Collapsed"/>
                    <Button x:Name="AddBookButton" Content="➕ Добавить книгу"
                            FontSize="12" Padding="10,5"
                            Background="#2ECC71" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="AddBookButton_Click"
                            Visibility="Collapsed"/>
                    <Button Content="🚪 Выйти" FontSize="12" Padding="10,5"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Панель поиска и фильтрации -->
        <Border Grid.Row="1" Background="White" Padding="15,10"
                BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox" Grid.Column="0"
                         FontSize="13" Padding="8,5"
                         BorderBrush="#BDC3C7" BorderThickness="1"
                         TextChanged="SearchTextBox_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="🔍 Поиск по названию или описанию..."
                                                               Foreground="#95A5A6" FontSize="13" Margin="8,0,0,0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <TextBlock Text="Жанр:" Grid.Column="1" FontSize="13"
                           VerticalAlignment="Center" Margin="15,0,5,0"
                           Foreground="#34495E"/>
                <ComboBox x:Name="GenreComboBox" Grid.Column="2"
                          FontSize="13" Padding="8,4" MinWidth="150"
                          BorderBrush="#BDC3C7"
                          SelectionChanged="GenreComboBox_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- Список книг -->
        <ListBox x:Name="BooksListBox" Grid.Row="2"
                 Background="Transparent" BorderThickness="0"
                 Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="BooksListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="3"
                            BorderBrush="#E0E0E0" BorderThickness="1" Width="780">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Название книги -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Title}" 
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="#2C3E50"/>

                            <!-- Жанр -->
                            <Border Grid.Row="0" Grid.Column="1" 
                                    Background="#EBF5FB" CornerRadius="10"
                                    Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Genre}" FontSize="11"
                                           Foreground="#2980B9"/>
                            </Border>

                            <!-- Описание -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="{Binding Description}" 
                                       FontSize="13" Foreground="#7F8C8D"
                                       TextWrapping="Wrap" Margin="0,5,0,5"
                                       MaxHeight="40" TextTrimming="CharacterEllipsis"/>

                            <!-- Дата публикации -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       FontSize="11" Foreground="#95A5A6">
                                <TextBlock.Text>
                                    <Binding Path="PublishedDate" StringFormat="Опубликовано: {0:dd.MM.yyyy}"/>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
