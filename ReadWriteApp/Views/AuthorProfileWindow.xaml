<Window x:Class="ReadWriteApp.Views.AuthorProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль автора" 
        Height="520" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Border Background="White" CornerRadius="8" Padding="20"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <TextBlock Grid.Row="0" Text="👤 Профиль автора"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,15"/>

                <!-- Имя -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Имя:" FontSize="13" 
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <TextBox x:Name="FirstNameTextBox" FontSize="13" Padding="8,5"
                             BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <!-- Фамилия -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Фамилия:" FontSize="13" 
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <TextBox x:Name="LastNameTextBox" FontSize="13" Padding="8,5"
                             BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <!-- Биография -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="О себе:" FontSize="13" 
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <TextBox x:Name="BioTextBox" FontSize="13" Padding="8,5"
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Height="80" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Заголовок списка книг -->
                <TextBlock Grid.Row="4" Text="📚 Книги автора:"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#2C3E50" Margin="0,5,0,8"/>

                <!-- Список книг автора -->
                <ListBox x:Name="AuthorBooksListBox" Grid.Row="5"
                         BorderBrush="#E0E0E0" BorderThickness="1"
                         Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5,3">
                                <TextBlock Text="{Binding Title}" FontSize="13"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text=" — " FontSize="13" Foreground="#BDC3C7"/>
                                <TextBlock Text="{Binding GenresDisplay}" FontSize="13"
                                           Foreground="#7F8C8D"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Кнопки -->
                <StackPanel Grid.Row="6" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="💾 Сохранить"
                            FontSize="12" Padding="15,7"
                            Background="#3498DB" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="SaveButton_Click" Visibility="Collapsed"/>
                    <Button Content="Закрыть" FontSize="12" Padding="15,7"
                            Background="#95A5A6" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
