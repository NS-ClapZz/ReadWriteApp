<Window x:Class="ReadWriteApp.Views.AddEditBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить книгу" 
        Height="530" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Border Background="White" CornerRadius="8" Padding="20"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок окна -->
                <TextBlock x:Name="WindowTitle" Grid.Row="0" 
                           Text="📝 Новая книга"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,15"/>

                <!-- Название -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="Название:" FontSize="13" 
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleTextBox" FontSize="13" Padding="8,5"
                             BorderBrush="#BDC3C7" BorderThickness="1"/>
                </StackPanel>

                <!-- Жанр -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="Жанр:" FontSize="13" 
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <ComboBox x:Name="GenreComboBox" FontSize="13" Padding="8,4"
                              BorderBrush="#BDC3C7" IsEditable="True">
                        <ComboBoxItem Content="Сказка"/>
                        <ComboBoxItem Content="Фантастика"/>
                        <ComboBoxItem Content="Поэзия"/>
                        <ComboBoxItem Content="Рассказ"/>
                        <ComboBoxItem Content="Повесть"/>
                        <ComboBoxItem Content="Роман"/>
                        <ComboBoxItem Content="Детектив"/>
                        <ComboBoxItem Content="Приключения"/>
                    </ComboBox>
                </StackPanel>

                <!-- Описание -->
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <TextBlock Text="Описание:" FontSize="13" 
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <TextBox x:Name="DescriptionTextBox" FontSize="13" Padding="8,5"
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             Height="60" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Содержание -->
                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="Текст книги:" FontSize="13" 
                               Foreground="#34495E" Margin="0,0,0,4"/>
                    <TextBox x:Name="ContentTextBox" FontSize="13" Padding="8,5"
                             BorderBrush="#BDC3C7" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <!-- Сообщение об ошибке -->
                <TextBlock x:Name="ErrorText" Grid.Row="5" Text=""
                           FontSize="12" Foreground="#E74C3C"
                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                <!-- Кнопки -->
                <StackPanel Grid.Row="6" Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Сохранить" FontSize="13"
                            Padding="20,8" Margin="0,0,10,0"
                            Background="#3498DB" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="SaveButton_Click"/>
                    <Button Content="Отмена" FontSize="13"
                            Padding="20,8"
                            Background="#95A5A6" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
