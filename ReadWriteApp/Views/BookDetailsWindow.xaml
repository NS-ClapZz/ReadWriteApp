<Window x:Class="ReadWriteApp.Views.BookDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр книги" 
        Height="550" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Border Background="White" CornerRadius="8" Padding="20"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Название книги -->
                <TextBlock x:Name="BookTitle" Grid.Row="0"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#2C3E50" TextWrapping="Wrap"
                           Margin="0,0,0,8"/>

                <!-- Информация об авторе и жанре -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock x:Name="AuthorName" FontSize="13" Foreground="#3498DB"
                               Cursor="Hand" MouseLeftButtonDown="AuthorName_Click"/>
                    <TextBlock Text="  •  " FontSize="13" Foreground="#BDC3C7"/>
                    <Border Background="#EBF5FB" CornerRadius="8" Padding="8,2">
                        <TextBlock x:Name="BookGenre" FontSize="11" Foreground="#2980B9"/>
                    </Border>
                </StackPanel>

                <!-- Дата публикации -->
                <TextBlock x:Name="PublishDate" Grid.Row="2"
                           FontSize="11" Foreground="#95A5A6" Margin="0,0,0,10"/>

                <!-- Описание -->
                <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="5" 
                        Padding="12" Margin="0,0,0,10">
                    <TextBlock x:Name="BookDescription" FontSize="13"
                               Foreground="#555555" TextWrapping="Wrap"
                               FontStyle="Italic"/>
                </Border>

                <!-- Текст книги -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,10">
                    <TextBlock x:Name="BookContent" FontSize="14"
                               Foreground="#2C3E50" TextWrapping="Wrap"
                               LineHeight="22"/>
                </ScrollViewer>

                <!-- Кнопки -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button x:Name="EditButton" Content="✏️ Редактировать"
                            FontSize="12" Padding="15,7"
                            Background="#F39C12" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="EditButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="DeleteButton" Content="🗑️ Удалить"
                            FontSize="12" Padding="15,7"
                            Background="#E74C3C" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"
                            Click="DeleteButton_Click" Visibility="Collapsed"/>
                    <Button Content="Закрыть" FontSize="12" Padding="15,7"
                            Background="#95A5A6" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
