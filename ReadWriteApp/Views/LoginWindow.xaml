<Window x:Class="ReadWriteApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Читай, Пиши и не спиши — Вход" 
        Height="560" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <DropShadowEffect x:Key="ShadowEffect" BlurRadius="15" 
                          ShadowDepth="2" Opacity="0.15" Color="Black"/>
    </Window.Resources>

    <Grid>
        <Border Background="White" CornerRadius="10" Margin="25"
                Padding="20" VerticalAlignment="Center"
                Effect="{StaticResource ShadowEffect}">
            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="📚 Читай, Пиши" 
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50"/>
                <TextBlock Text="и не спиши" 
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#2C3E50" Margin="0,0,0,3"/>
                <TextBlock Text="Пространство для маленьких авторов"
                           FontSize="11" Foreground="#7F8C8D"
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Логин -->
                <TextBlock Text="Логин:" FontSize="13" Foreground="#34495E" Margin="0,0,0,4"/>
                <TextBox x:Name="LoginTextBox" FontSize="14" Padding="8,5"
                         BorderBrush="#BDC3C7" BorderThickness="1"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль:" FontSize="13" Foreground="#34495E" Margin="0,10,0,4"/>
                <PasswordBox x:Name="PasswordBox" FontSize="14" Padding="8,5"
                             BorderBrush="#BDC3C7" BorderThickness="1"/>

                <!-- Выбор роли (для регистрации) -->
                <TextBlock Text="Роль (для регистрации):" FontSize="13" 
                           Foreground="#34495E" Margin="0,10,0,4"/>
                <ComboBox x:Name="RoleComboBox" FontSize="13" Padding="8,4"
                          BorderBrush="#BDC3C7" SelectedIndex="0">
                    <ComboBoxItem Content="Читатель"/>
                    <ComboBoxItem Content="Автор"/>
                </ComboBox>

                <!-- Сообщение об ошибке -->
                <TextBlock x:Name="ErrorText" Text=""
                           FontSize="12" Foreground="#E74C3C"
                           HorizontalAlignment="Center" Margin="0,10,0,0"
                           TextWrapping="Wrap"/>

                <!-- Кнопки -->
                <Button x:Name="LoginButton" Content="Войти"
                        FontSize="14" FontWeight="SemiBold"
                        Height="36" Margin="0,12,0,0"
                        Background="#3498DB" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="LoginButton_Click"/>

                <Button x:Name="RegisterButton" Content="Зарегистрироваться"
                        FontSize="13"
                        Height="34" Margin="0,8,0,0"
                        Background="#2ECC71" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Click="RegisterButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
